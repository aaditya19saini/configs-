# Allowlist: everything is ignored unless opted back in below, so app data,
# caches and logins that apps drop into ~/.config stay out of this public repo.
/*
!/.gitignore
!/README.md
!/restore.sh

# ── Desktop: Omarchy + Hyprland ──
!/omarchy/
!/hypr/
!/hyprland-mimeapps.list
!/hyprland-preview-share-picker/
!/xdg-desktop-portal/
!/xdg-terminals.list
!/mimeapps.list
!/user-dirs.dirs
!/environment.d/
!/autostart/
!/systemd/
!/wireplumber/
!/easyeffects/
!/voxtype/
!/gpu-switch/
!/omen-fan-control/
!/OpenDisplay/
!/fcitx5/

# ── Terminals, shell, CLI ──
!/alacritty/
!/foot/
!/ghostty/
!/kitty/
!/tmux/
!/herdr/
!/fish/
!/starship.toml
!/git/
!/lazygit/
!/btop/
!/mise/
!/nvim/
!/zed/
!/cliamp/

# ── Apps ──
!/brave-flags.conf
!/chromium-flags.conf
!/google-chrome/
!/google-chrome-beta/
!/google-chrome-unstable/
!/microsoft-edge/
!/microsoft-edge-dev/
!/faugus-launcher/
!/goverlay/
!/MangoHud/
!/vkBasalt/
!/vkSumi/
!/imv/
!/kdenliverc
!/xournalpp/
!/qalculate/
!/tensaku/
!/hype/
!/omacom/
!/Omacom/
!/pdfcraft/
!/ReadIt/

# ── Never, even inside allowed folders ──
*.bak
*.bak.*
*.log
*.lock
*.pid
*.sock
*.tmp
*~

# Omarchy: other people's themes/plugins are git clones; restore.sh reinstalls them.
/omarchy/backups/
/omarchy/themes/*
!/omarchy/themes/isle-of-the-dead/
!/omarchy/themes/megadeth/
/omarchy/plugins/io.*/
/omarchy/defaults/*.lock

# App state / history inside otherwise-useful folders
/cliamp/*
!/cliamp/config.toml
/herdr/*
!/herdr/config.toml
/goverlay/*
!/goverlay/goverlay.conf
!/goverlay/blacklist.conf
/omen-fan-control/*
!/omen-fan-control/config.json
!/omen-fan-control/curve.csv
/fcitx5/conf/cached_layouts
/Omacom/omawrite.conf
